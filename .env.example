# Kratos CRM public API base — must include the /api/v1 suffix.
# Production:
# NEXT_PUBLIC_API_BASE=https://api.kratos-energy.com/api/v1
# Local dev backend:
NEXT_PUBLIC_API_BASE=http://192.168.0.220:4000/api/v1

# Canonical site origin — used for canonicals, sitemaps, robots and JSON-LD.
# Must be exactly https://kratos-energy.com in production; anything else makes
# the build non-indexable (robots.txt returns Disallow: /).
NEXT_PUBLIC_SITE_URL=https://kratos-energy.com

# Google Search Console verification token. Leave empty until issued — the
# meta tag is omitted entirely when this is blank.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager container ID. Defaults to the live container when unset;
# set it to an empty value on staging/preview to disable GTM entirely.
NEXT_PUBLIC_GTM_ID=GTM-5RR9ZRTC

# Meta (Facebook) Pixel ID. Defaults to the live pixel when unset; set it to an
# empty value on staging/preview to disable the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=1654900768199262
