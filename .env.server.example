# Server build configuration.
#
# Copy this to `.env` NEXT TO docker-compose.yml on the VPS. Docker Compose
# reads it automatically to fill the build args — it is not shipped into the
# image (.dockerignore excludes .env*), and it is git-ignored.
#
# Every value here is inlined at BUILD time. Changing one means:
#   docker compose build --no-cache web && docker compose up -d
# Restarting the container alone does nothing.

NEXT_PUBLIC_API_BASE=https://api.kratos-energy.com/api/v1

# Must be exactly this on production. Any other value makes the whole site
# non-indexable — robots.txt will serve "Disallow: /".
NEXT_PUBLIC_SITE_URL=https://kratos-energy.com

# Google Search Console token: the CONTENT VALUE ONLY.
# Google shows you:  <meta name="google-site-verification" content="AbC123..." />
# Put here:          AbC123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
